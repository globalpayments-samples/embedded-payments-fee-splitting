# =============================================================================
# Global Payments API Configuration
# =============================================================================
# Get your GP API credentials at: https://developer.globalpay.com/
#
# IMPORTANT: Never commit your actual .env file!
# =============================================================================

# Backend API Credentials (Server-Side SDK Configuration)
# These credentials are used by the Node.js SDK for payment processing
# Card data is sent directly from the frontend to the backend
# Format: Long alphanumeric strings from GP API dashboard
GP_APP_ID=your_gp_api_app_id_here
GP_APP_KEY=your_gp_api_app_key_here

# API Environment (TEST or PRODUCTION)
# Use 'TEST' for sandbox, 'PRODUCTION' for live transactions
GP_API_ENVIRONMENT=TEST

# =============================================================================
# Embedded Payments Configuration
# =============================================================================

# Platform fee percentage (3-5%)
PLATFORM_FEE_RATE=3.0

# =============================================================================
# ProPay Configuration (for SplitFunds - future implementation)
# =============================================================================
# These are mock values from SDK tests for demo purposes
# Replace with actual ProPay credentials for production

# Platform's ProPay account number (receives funds, then splits to sellers)
PLATFORM_PROPAY_ACCOUNT=718580391
